{
  "name": "langswitcher-promo",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:ru && npm run render:en",
    "render:ru": "remotion render src/index.ts Promo out/langswitcher-promo.mp4",
    "render:en": "remotion render src/index.ts PromoEn out/langswitcher-promo.en.mp4",
    "audio": "uv run --with numpy python scripts/make_audio.py"
  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "@remotion/media": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
